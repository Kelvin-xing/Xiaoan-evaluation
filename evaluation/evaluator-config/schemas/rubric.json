{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimensions",
    "red_lines"
  ],
  "properties": {
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["module", "score", "reason", "supporting_evidence", "deduction_evidence"],
        "properties": {
          "module": {"type": "string"}, "score": {"type": "integer"}, "reason": {"type": "string"},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "deduction_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "red_lines": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "triggered", "reason", "evidence"],
        "properties": {
          "id": {"type": "string"}, "triggered": {"type": "boolean"},
          "reason": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
